<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="120dp"
    android:layout_margin="2dp">

    <ImageView
        android:id="@+id/imageView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/selectableItemBackground"
        android:contentDescription="@string/foto"
        android:scaleType="centerCrop" />

    <View
        android:id="@+id/selectionOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#800D0D1F"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/checkIcon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="top|start"
        android:layout_margin="6dp"
        android:background="@drawable/circle_check_bg"
        android:contentDescription="@string/seleccionar"
        android:padding="4dp"
        android:src="@drawable/ic_check"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/heartIcon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="top|end"
        android:layout_margin="6dp"
        android:contentDescription="@string/favorito"
        android:src="@drawable/ic_heart_filled"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/videoIcon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="bottom|start"
        android:layout_margin="6dp"
        android:contentDescription="@string/video"
        android:src="@drawable/ic_video"
        android:visibility="gone" />

    <TextView
        android:id="@+id/videoDuration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="6dp"
        android:background="#80000000"
        android:paddingStart="6dp"
        android:paddingTop="2dp"
        android:paddingEnd="6dp"
        android:paddingBottom="2dp"
        android:textColor="@color/fstly_text"
        android:textSize="11sp"
        android:visibility="gone" />

</FrameLayout>
